<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Nova runtime permissions ─────────────────────────────────────────
         Nova is a sideloaded, personal-use background companion. It has no
         screens; everything below supports the always-on wake-word service,
         the floating status dot, and the generic app driver. -->

    <!-- Persistent foreground service that keeps the mic listener alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- On-device wake word + STT. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- "Call <contact>" — look up a number by name. Dialing itself goes
         through ACTION_DIAL (opens the dialer, user taps call), so no
         CALL_PHONE permission is needed. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Floating status dot rendered over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 13+ requires this before a foreground service notification shows. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Generic "open any app" intent resolution needs the full package list. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Meeting capture (Phase 2). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Nova"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ── Persistent wake-word listener ───────────────────────────────
             Mandatory notification is unavoidable on Android; Nova leans into
             it as one of the two status-icon render targets. -->
        <service
            android:name=".WakeWordForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-on on-device voice companion (personal, sideloaded)" />
        </service>

        <!-- ── Floating status dot (SYSTEM_ALERT_WINDOW) ──────────────────── -->
        <service
            android:name=".OverlayService"
            android:exported="false" />

        <!-- ── Generic Accessibility driver ───────────────────────────────
             One driver reused for Gmail / WhatsApp / any installed app.
             Enabled manually by the user in Android Settings. -->
        <service
            android:name=".AccessibilityBridge"
            android:exported="false"
            android:label="Nova app driver"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nova_accessibility_config" />
        </service>

        <!-- Re-arm the listener after reboot. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- speech_to_text -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- flutter_tts -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- dialer fallback for "call ..." -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>
</manifest>
